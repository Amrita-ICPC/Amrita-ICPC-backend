# Project Configurations
PROJECT_NAME="Amrita ICPC Coding Platform - Backend"
PROJECT_DESCRIPTION="A backend tool for Amrita ICPC Coding Platform"
VERSION="1.0.0"

# Environment Configuration
ENVIRONMENT="development"
MIGRATIONS_ENABLED=true

# API Configurations
API_HOST="127.0.0.1"
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000/api/v1
API_PREFIX="/api"

# Database Configuration
DATABASE_NAME=
DATABASE_HOST=localhost
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_URL=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_ENABLED=true

# API Rate Limiting (per authenticated user; requires Redis above)
RATE_LIMIT_RUN_TIMES=10
RATE_LIMIT_RUN_SECONDS=10
RATE_LIMIT_SUBMIT_TIMES=5
RATE_LIMIT_SUBMIT_SECONDS=10

# MinIO configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IMAGE_MAX_UPLOAD_SIZE_BYTES=5242880
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=amrita-icpc
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# Keycloak Configuration
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_USERS_SYNC_CLIENT_ID=
KEYCLOAK_USERS_SYNC_CLIENT_SECRET=

# Log Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="{asctime} {levelname} {message}"
LOG_DIR=logs/
USE_RICH_LOGGING=True

# Judge0 Configuration
JUDGE0_API_KEY=
JUDGE0_API_URL="https://api.judge0.com"
JUDGE0_API_TIMEOUT=30

# Judge0 Execution Limits (Global Safety Caps)
JUDGE0_MAX_CPU_TIME=15.0
JUDGE0_MAX_WALL_TIME=20.0
JUDGE0_MAX_MEMORY_KB=512000
JUDGE0_MIN_MEMORY_KB=65536
JUDGE0_STACK_LIMIT_KB=64000
JUDGE0_DEFAULT_CPU_TIME=5.0
JUDGE0_DEFAULT_MEMORY_KB=256000
JUDGE0_WALL_TIME_FACTOR=2.0

# Judge0 Batching & Backpressure
JUDGE0_BATCH_SIZE=20
JUDGE0_MAX_INFLIGHT=100

# Evaluation Pipeline Configuration
EVAL_MAX_CONCURRENT_TESTCASES=10
EVAL_MAX_ACTIVE_TASKS_PER_CONTEST=50
EVAL_POLL_INTERVAL_SECONDS=1.5
EVAL_SUBMISSION_DEADLINE_SECONDS=120
EVAL_BACKPRESSURE_RETRY_SECONDS=5
JUDGE0_TRANSIENT_MAX_RETRIES=8
JUDGE0_TRANSIENT_RETRY_MAX_BACKOFF_SECONDS=60

# Celery Worker Concurrency
CELERY_STUDENT_CONCURRENCY=8
CELERY_BULK_CONCURRENCY=4

# Observability -- distributed tracing (OTLP export). The full metrics/traces/
# logs stack (Grafana Alloy + Prometheus + Tempo + Loki + Grafana) lives in the
# infra/devsecops repo, not here. In production the endpoint below points at
# that repo's Alloy agent. For local dev, leave OTEL_EXPORTER_OTLP_ENDPOINT
# unset to disable tracing entirely (setup_telemetry() no-ops when it's empty).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api
OTEL_TRACES_SAMPLER_RATIO=1.0
