# Project Configurations
PROJECT_NAME="Amrita ICPC Coding Platform - Backend"
PROJECT_DESCRIPTION="A backend tool for Amrita ICPC Coding Platform"
VERSION="1.0.0"

# Environment Configuration
ENVIRONMENT="development"
MIGRATIONS_ENABLED=true

# API Configurations
API_HOST="127.0.0.1"
API_PORT=8000
API_PREFIX="/api"

# Database Configuration
DATABASE_NAME=
DATABASE_HOST=localhost
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_PORT=5432

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_ENABLED=true

# MinIO configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=amrita-icpc
MINIO_SECURE=false

# Keycloak Configuration
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_USERS_SYNC_CLIENT_ID=
KEYCLOAK_USERS_SYNC_CLIENT_SECRET=

# Log Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="{asctime} {levelname} {message}"
LOG_DIR=logs/
USE_RICH_LOGGING=True

# Judge0 Configuration
JUDGE0_API_KEY=
JUDGE0_API_URL="https://api.judge0.com"
JUDGE0_API_TIMEOUT=30
