# Project Configurations
PROJECT_NAME="Amrita ICPC Coding Platform - Backend"
PROJECT_DESCRIPTION="A backend tool for Amrita ICPC Coding Platform"
VERSION="1.0.0"

# Environment Configuration
ENVIRONMENT="development"

# API Configurations
API_HOST="127.0.0.1"
API_PORT=8000
API_PREFIX="/api"

# Database Configuration
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis configuration
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_ENABLED=true

# Log Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="{asctime} {levelname} {message}"
LOG_DIR=logs/
USE_RICH_LOGGING=True

# Judge0 Configuration
JUDGE0_API_KEY=
JUDGE0_API_URL="https://api.judge0.com"
JUDGE0_API_TIMEOUT=30

# Keycloak Configuration
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=master
KEYCLOAK_DEFAULT_REALM=master
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
